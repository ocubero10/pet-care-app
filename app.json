{
  "expo": {
    "name": "Liz & Pets",
    "slug": "pet-care-mobile",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "petcarepro",
    "platforms": ["ios", "android", "web"],
    "icon": "./assets/logo.png",
    "ios": {
      "supportsTablet": true,
